  "cards": [
    {
      "dot": "amber",
      "title": "Why scroll in steps",
      "items": [
        "The list is virtualized: only a slice of its items exists in the DOM at any moment",
        "So links are captured at every scroll position, not once at the end"
      ]
    },
    {
      "dot": "rose",
      "title": "Stop rule",
      "items": [
        "Stop after 5 scrolls in a row add no new links",
        "Hard cap of 100 scrolls"
      ]
    },
    {
      "dot": "emerald",
      "title": "After capture",
      "items": [
        "Each link is normalized (fragment removed) and followed once",
        "Only links inside the three target sections are scraped"
      ]
    }
