  "cards": [
    {
      "dot": "cyan",
      "title": "Classification rules",
      "items": [
        "New: the URL is not in url_index.json",
        "Updated: the Markdown's MD5 changed, or its title, last-update or next-review date changed",
        "Unchanged: everything else"
      ]
    },
    {
      "dot": "amber",
      "title": "What gets written",
      "items": [
        "The article .md and metadata .json are rewritten on every crawl",
        "url_index.json is saved after each article",
        "change_log.json records only new and updated articles, capped at the last 1,000"
      ]
    }
