        "bc_cancer follows every /health-info link from its start page",
        "canadian_cancer_society renders every page in 3 sections and scrolls A–Z lists to capture links",
        "cleveland_clinic POSTs each letter A–Z and # to an AJAX index, then scrapes the article URLs it returns"
      ]
    },
    {
      "dot": "emerald",
      "title": "Politeness",
      "items": [
        "robots.txt is obeyed and cookies are off",
        "2 s between requests by default; 1 s with lower concurrency for cancer.ca and Cleveland Clinic",
        "cancer.ca timeouts are retried up to 3 times with a 90 s limit"
      ]
    },
    {
      "dot": "amber",
      "title": "Change detection",
      "items": [
        "New: the URL is not yet in url_index.json",
        "Updated: the Markdown's MD5 or its title / review dates changed",
        "Every crawled article is rewritten; change_log.json keeps the last 1,000 new or updated events"
      ]
    }
